<?xml version="1.0" encoding="utf-8"?>
<!--
  Group Policy for Vox. Copy Vox.admx to %SystemRoot%\PolicyDefinitions (or the domain's
  Central Store) and en-US\Vox.adml beside it in en-US. Values go to Software\Policies\Vox
  (PolicySettings.ValueNames); any other setting can be enforced as a value named after it
  under Software\Policies\Vox\Settings (docs/enterprise.md).
-->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="vox" namespace="Vox.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Vox" displayName="$(string.SUPPORTED_Vox)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Vox" displayName="$(string.Vox)" />
  </categories>
  <policies>
    <policy name="DisableNetwork" class="Both" displayName="$(string.DisableNetwork)" explainText="$(string.DisableNetwork_Help)"
            key="Software\Policies\Vox" valueName="DisableNetwork">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="DisableUpdates" class="Both" displayName="$(string.DisableUpdates)" explainText="$(string.DisableUpdates_Help)"
            key="Software\Policies\Vox" valueName="DisableUpdates">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="UpdateChannel" class="Both" displayName="$(string.UpdateChannel)" explainText="$(string.UpdateChannel_Help)"
            key="Software\Policies\Vox" presentation="$(presentation.UpdateChannel)">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <elements>
        <enum id="UpdateChannel" valueName="UpdateChannel" required="true">
          <item displayName="$(string.UpdateChannel_Stable)"><value><string>Stable</string></value></item>
          <item displayName="$(string.UpdateChannel_Beta)"><value><string>Beta</string></value></item>
          <item displayName="$(string.UpdateChannel_Off)"><value><string>Off</string></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="DisableAddOns" class="Both" displayName="$(string.DisableAddOns)" explainText="$(string.DisableAddOns_Help)"
            key="Software\Policies\Vox" valueName="DisableAddOns">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="DisableAI" class="Both" displayName="$(string.DisableAI)" explainText="$(string.DisableAI_Help)"
            key="Software\Policies\Vox" valueName="DisableAI">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="StartAtLogon" class="Both" displayName="$(string.StartAtLogon)" explainText="$(string.StartAtLogon_Help)"
            key="Software\Policies\Vox" valueName="StartAtLogon">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="LockSettings" class="Both" displayName="$(string.LockSettings)" explainText="$(string.LockSettings_Help)"
            key="Software\Policies\Vox" valueName="LockSettings">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="SettingsLocation" class="Both" displayName="$(string.SettingsLocation)" explainText="$(string.SettingsLocation_Help)"
            key="Software\Policies\Vox" presentation="$(presentation.SettingsLocation)">
      <parentCategory ref="Vox" />
      <supportedOn ref="SUPPORTED_Vox" />
      <elements>
        <enum id="SettingsLocation" valueName="SettingsLocation" required="true">
          <item displayName="$(string.SettingsLocation_Roaming)"><value><string>Roaming</string></value></item>
          <item displayName="$(string.SettingsLocation_Local)"><value><string>Local</string></value></item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
