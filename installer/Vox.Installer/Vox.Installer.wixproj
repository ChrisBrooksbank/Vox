<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Builds Vox.msi from a published Vox (Vox.App, Vox.Watchdog and Vox.Service in one folder):
      dotnet build installer/Vox.Installer -c Release -p:PublishDir=<folder> -p:VoxVersion=1.2.3
    Windows only, so it isn't in Vox.sln; the Release workflow runs it (docs/installer.md).
  -->
  <PropertyGroup>
    <OutputName>Vox</OutputName>
    <!-- Vox is published for win-x64 into Program Files (64-bit): a 32-bit package fails ICE80 and
         would write HKLM\Software\Vox under WOW6432Node, where the 64-bit Vox doesn't look -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE38/43/57 assume the shortcut folders are per-user; the package is per-machine, so they are
         the All Users folders and the shortcut components' HKLM key paths are right -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
    <VoxVersion Condition="'$(VoxVersion)' == ''">0.1.0</VoxVersion>
    <DefineConstants>PublishDir=$(PublishDir);VoxVersion=$(VoxVersion)</DefineConstants>
    <SuppressValidation Condition="'$(OS)' != 'Windows_NT'">true</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
