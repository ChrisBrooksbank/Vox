<!--
  Vox installer: per-machine, to Program Files\Vox (a secure location, needed for UI access).
  - Every published file, the secure-screen service (VoxService, LocalSystem, automatic),
  - Start menu and desktop shortcuts to Vox.Watchdog (which keeps Vox running); the Start menu
    one has the Ctrl+Alt+V hotkey,
  - STARTATLOGON=1: a shortcut in the all-users Startup folder, so Vox starts at sign-in.
  - DESKTOPSHORTCUT=0: no desktop shortcut; INSTALLSERVICE=0: no secure-screen service.
  - UPDATECHANNEL, KEYBOARDLAYOUT, MODIFIERKEY, VERBOSITY, SPEECHRATE, LANGUAGE: the computer's
    default settings, written to HKLM\Software\Vox\Defaults (MachineSettings; a property not
    given writes an empty value, which Vox ignores). Users can still change them; to enforce
    a setting use Group Policy (installer/policy, docs/enterprise.md).
  Silent install: msiexec /i Vox.msi /qn STARTATLOGON=1 UPDATECHANNEL=Off KEYBOARDLAYOUT=Laptop
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Vox Screen Reader" Manufacturer="Vox" Version="$(var.VoxVersion)"
           UpgradeCode="{3CB5D444-22D1-43A1-BF28-7035F8DE7DD4}" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Vox is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="STARTATLOGON" Value="0" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="INSTALLSERVICE" Value="1" Secure="yes" />
    <Property Id="UPDATECHANNEL" Secure="yes" />
    <Property Id="KEYBOARDLAYOUT" Secure="yes" />
    <Property Id="MODIFIERKEY" Secure="yes" />
    <Property Id="VERBOSITY" Secure="yes" />
    <Property Id="SPEECHRATE" Secure="yes" />
    <Property Id="LANGUAGE" Secure="yes" />
    <Property Id="ARPCOMMENTS" Value="A screen reader for Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vox" />
    </StandardDirectory>

    <Feature Id="Vox" Title="Vox" Level="1">
      <ComponentGroupRef Id="VoxFiles" />
      <ComponentRef Id="VoxService" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartAtLogon" />
      <ComponentRef Id="MachineDefaults" />
    </Feature>

    <ComponentGroup Id="VoxFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\Vox.Service.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="VoxService" Directory="INSTALLFOLDER" Condition="INSTALLSERVICE = 1">
      <File Id="VoxServiceExe" Source="$(var.PublishDir)\Vox.Service.exe" KeyPath="yes" />
      <ServiceInstall Name="VoxService" DisplayName="Vox secure screens"
                      Description="Reads the sign-in, lock and UAC screens with Vox."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
      <ServiceControl Id="VoxServiceControl" Name="VoxService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!-- Hotkey: low byte the key (V, 0x56), high byte the modifiers (Ctrl 0x02 + Alt 0x04) -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="VoxStartMenu" Name="Vox" Description="Vox screen reader"
                Target="[INSTALLFOLDER]Vox.Watchdog.exe" WorkingDirectory="INSTALLFOLDER" Hotkey="1622" />
      <RegistryValue Root="HKLM" Key="Software\Vox" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = 1">
      <Shortcut Id="VoxDesktop" Name="Vox" Description="Vox screen reader"
                Target="[INSTALLFOLDER]Vox.Watchdog.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\Vox" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartAtLogon" Directory="StartupFolder" Condition="STARTATLOGON = 1">
      <Shortcut Id="VoxStartup" Name="Vox" Description="Start Vox at sign-in"
                Target="[INSTALLFOLDER]Vox.Watchdog.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\Vox" Name="StartAtLogon" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The computer's default settings from the installer's properties (empty when not given) -->
    <Component Id="MachineDefaults" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="Software\Vox\Defaults" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="UpdateChannel" Type="string" Value="[UPDATECHANNEL]" />
        <RegistryValue Name="KeyboardLayout" Type="string" Value="[KEYBOARDLAYOUT]" />
        <RegistryValue Name="ModifierKey" Type="string" Value="[MODIFIERKEY]" />
        <RegistryValue Name="VerbosityLevel" Type="string" Value="[VERBOSITY]" />
        <RegistryValue Name="SpeechRateWpm" Type="string" Value="[SPEECHRATE]" />
        <RegistryValue Name="Language" Type="string" Value="[LANGUAGE]" />
      </RegistryKey>
      <RegistryValue Root="HKLM" Key="Software\Vox" Name="MachineDefaults" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
