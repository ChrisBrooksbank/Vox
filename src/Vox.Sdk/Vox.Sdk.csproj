<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The public add-on API (docs/addons.md). Add-ons reference only this assembly; it never
    references Vox.Core, so Vox's internals can change without breaking them. Its version is
    VoxApi.Current: a minor version only adds, a major version may break.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Records document only the parameters that need it -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0050</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>
</Project>
