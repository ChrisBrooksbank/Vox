<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- UI access needs a signed exe: only signed builds ask for it (docs/signing.md) -->
    <ApplicationManifest Condition="'$(VoxSigningCertificate)' == ''">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(VoxSigningCertificate)' != ''">app.uiaccess.manifest</ApplicationManifest>
    <VoxSignTool Condition="'$(VoxSignTool)' == ''">signtool.exe</VoxSignTool>
    <VoxTimestampUrl Condition="'$(VoxTimestampUrl)' == ''">http://timestamp.digicert.com</VoxTimestampUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vox.Core\Vox.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SoundAssets Include="$(MSBuildProjectDirectory)\..\..\assets\sounds\**\*.wav;$(MSBuildProjectDirectory)\..\..\assets\sounds\**\manifest.json" />
  </ItemGroup>
  <!--
    Authenticode-signs Vox.App.exe when a certificate is configured, e.g.
      dotnet build -c Release -p:VoxSigningCertificate=C:\certs\vox.pfx -p:VoxSigningPassword=...
    or, for a certificate in the store: -p:VoxSigningCertificate=store -p:VoxSigningThumbprint=ABC123...
  -->
  <Target Name="SignVoxApp" AfterTargets="Build" Condition="'$(VoxSigningCertificate)' != '' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_VoxExe>$(OutDir)$(AssemblyName).exe</_VoxExe>
      <_VoxCertArgs Condition="'$(VoxSigningCertificate)' == 'store'">/sha1 $(VoxSigningThumbprint)</_VoxCertArgs>
      <_VoxCertArgs Condition="'$(VoxSigningCertificate)' != 'store'">/f "$(VoxSigningCertificate)" /p "$(VoxSigningPassword)"</_VoxCertArgs>
    </PropertyGroup>
    <Exec Command="&quot;$(VoxSignTool)&quot; sign $(_VoxCertArgs) /fd SHA256 /tr $(VoxTimestampUrl) /td SHA256 &quot;$(_VoxExe)&quot;" />
  </Target>

  <Target Name="CopyConfigAssets" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)assets\config" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\assets\config\default-settings.json" DestinationFolder="$(OutputPath)assets\config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\assets\config\default-keymap.json" DestinationFolder="$(OutputPath)assets\config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\assets\config\laptop-keymap.json" DestinationFolder="$(OutputPath)assets\config" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutputPath)assets\sounds" />
    <Copy SourceFiles="@(SoundAssets)" DestinationFolder="$(OutputPath)assets\sounds\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The user guide (docs/guide) goes beside Vox, with its keyboard reference generated from the
    keymaps just copied: Vox.App writes it with the keyboard-reference switch (Windows builds only).
  -->
  <ItemGroup>
    <GuideFiles Include="$(MSBuildProjectDirectory)\..\..\docs\guide\*.html;$(MSBuildProjectDirectory)\..\..\docs\guide\*.css" />
  </ItemGroup>
  <Target Name="BuildUserGuide" AfterTargets="CopyConfigAssets">
    <MakeDir Directories="$(TargetDir)docs\guide" />
    <Copy SourceFiles="@(GuideFiles)" DestinationFolder="$(TargetDir)docs\guide" SkipUnchangedFiles="true" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" ContinueOnError="true"
          Command="dotnet &quot;$(TargetPath)&quot; --keyboard-reference &quot;$(TargetDir)docs\guide\keyboard.html&quot;" />
  </Target>
</Project>
