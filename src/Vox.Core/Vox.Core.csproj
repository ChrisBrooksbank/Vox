<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Strings.resx is English; Strings.<language>.resx are its translations (docs/translating.md) -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in fallback keymap, used when assets/config/default-keymap.json is missing or invalid -->
    <EmbeddedResource Include="..\..\assets\config\default-keymap.json" LogicalName="Vox.Core.default-keymap.json" />
    <EmbeddedResource Include="..\..\assets\config\laptop-keymap.json" LogicalName="Vox.Core.laptop-keymap.json" />
    <EmbeddedResource Include="..\..\assets\speech\*.json" LogicalName="Vox.Core.speech.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\braille\*.json" LogicalName="Vox.Core.braille.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\braille\keymaps\*.json" LogicalName="Vox.Core.braille.keymaps.%(Filename)%(Extension)" />
    <!-- App modules' keys (AppModuleKeyMaps): assets/apps/<module id>.json -->
    <EmbeddedResource Include="..\..\assets\apps\*.json" LogicalName="Vox.Core.apps.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
