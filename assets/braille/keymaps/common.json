{
  "//": "Keys every braille display has (HID braille names). A display's own file (hid.json, brltty.json) is laid over these. Unbound chords of dot keys are typed as braille.",
  "bindings": [
    { "keys": ["panLeft"], "action": "PanLeft" },
    { "keys": ["panRight"], "action": "PanRight" },
    { "keys": ["routing"], "action": "Route" },
    { "keys": ["rockerUp"], "action": "PreviousLine" },
    { "keys": ["rockerDown"], "action": "NextLine" },
    { "keys": ["space"], "action": "Space" },
    { "keys": ["leftSpace"], "action": "Space" },
    { "keys": ["rightSpace"], "action": "Space" },
    { "keys": ["dot7"], "action": "Backspace" },
    { "keys": ["dot8"], "action": "Enter" },

    { "keys": ["joystickUp"], "key": "Up" },
    { "keys": ["joystickDown"], "key": "Down" },
    { "keys": ["joystickLeft"], "key": "Left" },
    { "keys": ["joystickRight"], "key": "Right" },
    { "keys": ["joystickCenter"], "key": "Enter" },
    { "keys": ["dpadUp"], "key": "Up" },
    { "keys": ["dpadDown"], "key": "Down" },
    { "keys": ["dpadLeft"], "key": "Left" },
    { "keys": ["dpadRight"], "key": "Right" },
    { "keys": ["dpadCenter"], "key": "Enter" },

    { "keys": ["space", "dot1"], "key": "Up" },
    { "keys": ["space", "dot4"], "key": "Down" },
    { "keys": ["space", "dot3"], "key": "Left" },
    { "keys": ["space", "dot6"], "key": "Right" },
    { "keys": ["space", "dot2"], "key": "Home" },
    { "keys": ["space", "dot5"], "key": "End" },
    { "keys": ["space", "dot4", "dot5"], "key": "Tab" },
    { "keys": ["space", "dot1", "dot2"], "key": "Shift+Tab" },
    { "keys": ["space", "dot1", "dot5"], "key": "Escape" },
    { "keys": ["space", "dot1", "dot4", "dot5"], "key": "Delete" },
    { "keys": ["space", "dot7"], "key": "Backspace" },
    { "keys": ["space", "dot8"], "key": "Enter" },

    { "keys": ["space", "dot1", "dot2", "dot5"], "command": "NextHeading" },
    { "keys": ["space", "dot1", "dot2", "dot3"], "command": "NextLink" },
    { "keys": ["space", "dot1", "dot2", "dot4"], "command": "Find" },
    { "keys": ["space", "dot1", "dot4"], "command": "SayFocus" },
    { "keys": ["space", "dot2", "dot3", "dot4", "dot5"], "command": "SayTitle" },
    { "keys": ["space", "dot2", "dot3", "dot4"], "command": "SayAll" },
    { "keys": ["space", "dot1", "dot3", "dot4"], "command": "OpenVoxMenu" },
    { "keys": ["space", "dot1", "dot2", "dot3", "dot6"], "command": "ToggleMode" },
    { "keys": ["space", "dot1", "dot2", "dot3", "dot4", "dot5", "dot6"], "command": "StopSpeech" },
    { "keys": ["space", "dot2", "dot4", "dot5"], "action": "CycleTether" }
  ]
}
