{
  "comment": "Laptop layout (NVDA laptop conventions), for keyboards without a numeric keypad; meant to be used with CapsLock as the screen reader key. It is the desktop layout (default-keymap.json) without the keypad bindings, plus these bindings, which replace any desktop binding on the same key. The Insert modifier means the screen reader key. VkCodes: arrows 37-40 (Left, Up, Right, Down), Home 36, End 35, Page Up 33, Page Down 34, Backspace 8, Enter 13, period 190, comma 188, [ 219, ] 221.",
  "bindings": [
    { "modifiers": "Insert",       "vkCode": 38,  "mode": "Any", "command": "ReviewPrevLine" },
    { "modifiers": "Insert|Shift", "vkCode": 190, "mode": "Any", "command": "ReviewCurrentLine" },
    { "modifiers": "Insert",       "vkCode": 40,  "mode": "Any", "command": "ReviewNextLine" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 37,  "mode": "Any", "command": "ReviewPrevWord" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 190, "mode": "Any", "command": "ReviewCurrentWord" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 39,  "mode": "Any", "command": "ReviewNextWord" },
    { "modifiers": "Insert",       "vkCode": 37,  "mode": "Any", "command": "ReviewPrevChar" },
    { "modifiers": "Insert",       "vkCode": 190, "mode": "Any", "command": "ReviewCurrentChar" },
    { "modifiers": "Insert",       "vkCode": 39,  "mode": "Any", "command": "ReviewNextChar" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 36,  "mode": "Any", "command": "ReviewTop" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 35,  "mode": "Any", "command": "ReviewBottom" },
    { "modifiers": "Insert",       "vkCode": 33,  "mode": "Any", "command": "PrevReviewMode" },
    { "modifiers": "Insert",       "vkCode": 34,  "mode": "Any", "command": "NextReviewMode" },
    { "modifiers": "Insert|Shift", "vkCode": 38,  "mode": "Any", "command": "NavigatorParent" },
    { "modifiers": "Insert|Shift", "vkCode": 40,  "mode": "Any", "command": "NavigatorFirstChild" },
    { "modifiers": "Insert|Shift", "vkCode": 37,  "mode": "Any", "command": "NavigatorPrevious" },
    { "modifiers": "Insert|Shift", "vkCode": 39,  "mode": "Any", "command": "NavigatorNext" },
    { "modifiers": "Insert|Shift", "vkCode": 79,  "mode": "Any", "command": "ReportNavigator" },
    { "modifiers": "Insert",       "vkCode": 8,   "mode": "Any", "command": "NavigatorToFocus" },
    { "modifiers": "Insert|Shift", "vkCode": 8,   "mode": "Any", "command": "FocusToNavigator" },
    { "modifiers": "Insert",       "vkCode": 13,  "mode": "Any", "command": "ActivateNavigator" },
    { "modifiers": "Insert",       "vkCode": 219, "mode": "Any", "command": "MouseLeftClick" },
    { "modifiers": "Insert",       "vkCode": 221, "mode": "Any", "command": "MouseRightClick" },
    { "modifiers": "Insert|Ctrl",  "vkCode": 219, "mode": "Any", "command": "ToggleLeftMouseLock" },
    { "modifiers": "Insert|Shift", "vkCode": 77,  "mode": "Any", "command": "RouteMouseToNavigator" },
    { "modifiers": "Insert",       "vkCode": 65,  "mode": "Any", "command": "SayAll" },
    { "modifiers": "Insert",       "vkCode": 76,  "mode": "Any", "command": "ReadCurrentLine" },
    { "modifiers": "Insert|Shift", "vkCode": 83,  "mode": "Any", "command": "ReadSelection" },
    { "modifiers": "Insert",       "vkCode": 188, "mode": "Any", "command": "ReadCurrentChar" }
  ]
}
